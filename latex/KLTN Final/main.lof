\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Ví dụ hội thoại nhiều lượt trong Hệ thống gợi ý hội thoại. Hệ thống chủ động đặt câu hỏi làm rõ sở thích, cập nhật trạng thái hội thoại và đưa ra gợi ý kèm giải thích qua từng lượt tương tác \cite {fang2024multiagentconversationalrecommender}.}}{14}{figure.caption.11}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Ví dụ cấu trúc một node Phim trong Đồ thị tri thức, liên kết với các thực thể Đạo diễn, Diễn viên, Thể loại và các thuộc tính định lượng. Mỗi bộ ba $(h, r, t)$ biểu diễn một quan hệ có hướng giữa hai thực thể trong đồ thị.}}{15}{figure.caption.12}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Pipeline RAG cơ bản gồm ba giai đoạn: \textit {Retrieval} (truy xuất tài liệu liên quan từ kho dữ liệu ngoài), \textit {Augmentation} (tích hợp tài liệu vào ngữ cảnh) và \textit {Generation} (LLM sinh câu trả lời được neo giữ vào dữ liệu thực chứng) \cite {singh2026agenticretrievalaugmentedgenerationsurvey}.}}{16}{figure.caption.13}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces So sánh các phương pháp prompting LLM: Standard, Chain-of-Thought, Act-only và \textbf {ReAct}. ReAct xen kẽ giữa suy luận (Thought) và hành động tương tác với môi trường (Action-Observation), cho phép tác tử tự điều chỉnh chiến lược dựa trên phản hồi từ môi trường \cite {yao2022react}.}}{18}{figure.caption.14}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Tổng quan kiến trúc hệ thống tiền đề GRACE, bao gồm hai module chính: LLM Retriever và LLM Re-ranker.}}{22}{figure.caption.15}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Cấu trúc một node Phim (Film) trong Đồ thị tri thức. Node này liên kết trực tiếp với các thuộc tính (Năm, Điểm số, Thể loại) và các thực thể sáng tạo (Đạo diễn, Diễn viên).}}{23}{figure.caption.16}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Quy trình truy xuất ngữ nghĩa dựa trên phép tính tương đồng Cosine giữa vector của câu truy vấn và vector cốt truyện phim.}}{25}{figure.caption.17}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Cơ chế lọc theo nội dung dựa trên các thuộc tính cứng (Thể loại, Năm sản xuất, Điểm số).}}{26}{figure.caption.18}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Thuật toán mở rộng đồ thị dựa trên việc chia sẻ các node đội ngũ sáng tạo (Diễn viên, Đạo diễn).}}{26}{figure.caption.19}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Kiến trúc Module Xếp hạng lại, sử dụng cơ chế batching để xử lý tập ứng viên lớn thông qua LLM.}}{28}{figure.caption.20}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Kiến trúc tổng quan của hệ thống đa tác tử ARGOS. Khác với kiến trúc tĩnh, ARGOS đưa vào các vòng lặp phản hồi nội bộ (feedback loops) và cơ chế đánh giá lại trọng số động thông qua các Agent chuyên biệt.}}{31}{figure.caption.21}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Luồng suy luận của Profiler Agent: phân loại thông tin đầu vào thành ba nhánh độc lập (Explicit, Abstract, Behavioral) và tổng hợp bộ trọng số WRRF.}}{32}{figure.caption.22}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Cơ chế dự báo trọng số động (Dynamic Weight Prediction) do Profiler Agent thực hiện, cung cấp tín hiệu định tuyến cho các luồng truy xuất.}}{36}{figure.caption.23}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Chu trình ReAct của Graph Agent: xen kẽ Suy luận - Hành động - Quan sát để tự sửa lỗi và tối ưu chiến lược truy vấn đồ thị.}}{39}{figure.caption.24}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Chiến lược tìm kiếm đa luồng của Orchestrator Agent. Hệ thống kích hoạt song song ba luồng độc lập: Vòng lặp ReAct của Graph Agent, Semantic Retrieval và Content Retrieval, sau đó hợp nhất kết quả thông qua thuật toán WRRF Fusion có sử dụng trọng số động.}}{40}{figure.caption.25}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Cơ chế hoạt động của Critic Agent. Tác tử thực hiện đối soát chéo các ứng viên với Ràng buộc cứng (Hard Constraints) và kích hoạt cơ chế phản hồi (Feedback Trigger) nếu số lượng ứng viên hợp lệ không đạt ngưỡng dung sai.}}{43}{figure.caption.26}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Quy trình phân tích điểm nghẽn và tái cấu trúc ý định của Relaxation Agent. Dựa trên phân cấp ưu tiên (Sacrifice Hierarchy), tác tử nới lỏng các điều kiện tìm kiếm và khởi động lại vòng lặp hội thoại mới.}}{46}{figure.caption.27}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Quy trình xếp hạng hai giai đoạn (2-stage Reranking). Hệ thống kết hợp mô hình Rerank chuyên dụng để lọc nhanh danh sách ứng viên, sau đó tận dụng LLM để đánh giá sâu logic và đưa ra kết quả cuối cùng.}}{49}{figure.caption.28}%
